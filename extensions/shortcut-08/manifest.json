{
  "manifest_version": 3,
  "name": "Omni-Shortcut 08",
  "description": "Target URL access via shortcut 08",
  "version": "1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://t0.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Target URL access via shortcut 08"
  }
}
