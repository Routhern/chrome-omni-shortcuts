{
    "manifest_version": 3,
    "name": "Omni-Shortcut 1",
    "description": "Access to Target URL",
    "version": "1.0",
    "permissions": ["storage", "tabs", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Access to Target URL"
    },
    "options_page": "option.html"
  }