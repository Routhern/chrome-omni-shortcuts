{
  "manifest_version": 3,
  "name": "Shortcut Extension 9",
  "description": "Open a specific URL in a new window.",
  "version": "1.0",
  "action": {
      "default_icon": {
          "16": "favicon.png",
          "48": "favicon.png",
          "128": "favicon.png"
      }
  },
  "background": {
      "service_worker": "background.js"
  },
  "permissions": [
      "tabs"
  ],
  "icons": {
      "16": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
  }
}
