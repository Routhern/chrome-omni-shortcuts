{
  "manifest_version": 3,
  "name": "Omni-Shortcut 06",
  "description": "Target URL access via shortcut 06",
  "version": "1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://t0.gstatic.com/*"
  ],
  "icons": {
    "16": "icon.svg",
    "24": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Target URL access via shortcut 06",
    "default_icon": {
      "16": "icon.svg",
      "24": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  }
}
